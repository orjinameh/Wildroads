# Copy to .env (local) or add to Vercel project settings. Never commit .env.

# Where the app reaches Otari. Hosted: https://<region>.api.otari.ai/api/v1
# An EU key needs eu.api.otari.ai; the API names the right host if you use the wrong one.
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1

# Models, as the otari.ai Models tab shows them, or the name of a routing policy you created.
# Analyst: runs code on the road data and returns numbers. Writer: turns those numbers into the report.
# Each is the other's fallback if it is unreachable or returns a 5xx.
OTARI_MODEL=deepseek/deepseek-v4.1-flash
OTARI_WRITER_MODEL=z-ai/glm-5.3-flash

# One Otari key per community group, each with its own budget set in the otari.ai dashboard.
# JSON on one line. Server-side only: road users never see or type a key.
OTARI_KEYS={"lagos-mainland-group":"otk_...","demo-tiny-budget":"otk_..."}

# Storage. Leave MONGODB_URI empty to use a local SQLite file (local development only).
# On Vercel it is required (MongoDB Atlas connection string).
MONGODB_URI=
MONGODB_DB=wildroads
