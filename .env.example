# Copy to .env and fill in. Never commit .env.

# Admin key for the Otari gateway (used by the dashboard and by the ledger page).
OTARI_MASTER_KEY=change-me-to-a-long-random-string

# Upstream provider key (add more providers in otari/config.yml).
OPENAI_API_KEY=

# Generate with: openssl rand -base64 32   (required by Otari's full stack)
OTARI_PROVIDER_ACCOUNT_PEPPER=

# Two open-weight models, ids exactly as the otari.ai Models tab shows them.
# Analyst: runs code on the road data and returns numbers. Writer: turns those numbers into the report.
# Each is the other's fallback if it is unreachable or returns a 5xx.
OTARI_MODEL=deepseek/deepseek-v4.1-flash
OTARI_WRITER_MODEL=z-ai/glm-5.3-flash

# One Otari key per community group, each with its own budget set in the otari.ai dashboard.
# JSON on one line. Server-side only: road users never see or type a key.
OTARI_KEYS={"lagos-mainland-group":"otk_...","demo-tiny-budget":"otk_..."}

# Storage. Leave MONGODB_URI empty to use the built-in SQLite file (self-hosted Docker).
# Set it on Vercel or any host with a disposable disk (MongoDB Atlas connection string).
MONGODB_URI=
MONGODB_DB=wildroads

# Where the app reaches Otari.
#   Hosted platform (required by the hackathon): https://<region>.api.otari.ai/api/v1  (an EU key needs eu.api.otari.ai; the API answers with the right host if you use the wrong one)
#   Self-hosted: in Docker Compose this is set for you; elsewhere use the public URL of your gateway.
OTARI_BASE_URL=https://eu.api.otari.ai/api/v1
